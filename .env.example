# Application
ENVIRONMENT=local
LOG_LEVEL=INFO

# Database (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=OffBoardMe
DB_USER=postgres
# Required — set a secure password
DB_PASSWORD=

# Neo4j 5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required — set a secure password
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=offboardme-backend
# Generate with: python -c "import base64, uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes + uuid.uuid4().bytes)[:22].decode())"
KAFKA_CLUSTER_ID=

# Kafka transport security — SASL_SSL (SCRAM-SHA-512 over TLS). Generate certs
# and a SCRAM user with ./scripts/gen-kafka-certs.sh. Leave KAFKA_SECURITY_PROTOCOL
# as PLAINTEXT for local dev without Docker Compose (e.g. running tests).
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=./certs/ca.pem
# Docker Compose only (kafka/kafka-ui broker TLS keystore/truststore) — set by gen-kafka-certs.sh output
KAFKA_SSL_KEYSTORE_PASSWORD=
KAFKA_SSL_TRUSTSTORE_PASSWORD=

# JWT
# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=offboardme-backend

# Slack (pending integration)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=

# AI dossier generation (LLMDossierGenerator)
# The model lives in mcp-server's `generate_dossier` tool (its own
# MCP_SERVER_ANTHROPIC_API_KEY), not here — set to true to use it instead of
# FakeDossierGenerator.
DOSSIER_LLM_ENABLED=false
DOSSIER_LLM_TIMEOUT_SECONDS=45
# mcp-server's streamable-HTTP endpoint (default FastMCP path is /mcp)
MCP_SERVER_URL=http://localhost:8000/mcp

# Exposed Ports for local development
API_PORT=8888
KAFKA_UI_PORT=8080
NEO4J_BROWSER_PORT=7474
