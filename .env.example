# Application
ENVIRONMENT=local
LOG_LEVEL=INFO

# Database (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=OffBoardMe
DB_USER=postgres
# Required — set a secure password
DB_PASSWORD=

# Neo4j 5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required — set a secure password
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=offboardme-backend
# Generate with: python -c "import base64, uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes + uuid.uuid4().bytes)[:22].decode())"
KAFKA_CLUSTER_ID=

# JWT
# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=offboardme-backend

# Slack (pending integration)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=
